<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for GoViet Keyboard app. -->
    <style name="Theme.GoViet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colors - Sleek slate navy in light mode -->
        <item name="colorPrimary">@color/brand_primary_light</item>
        <item name="colorPrimaryDark">@color/brand_primary_light</item>
        <item name="colorAccent">@color/brand_primary_light</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Custom surface, background, and text colors -->
        <item name="colorSurface">@color/brand_surface_light</item>
        <item name="android:colorBackground">@color/brand_background_light</item>
        <item name="colorOnSurface">@color/brand_text_light</item>
        <item name="colorOnSurfaceVariant">@color/brand_secondary_text_light</item>
        <item name="colorSurfaceVariant">@color/brand_card_light</item>
    </style>

    <!-- Keep Theme.MyApplication inheriting from Theme.GoViet for backward compatibility -->
    <style name="Theme.MyApplication" parent="Theme.GoViet" />
</resources>
